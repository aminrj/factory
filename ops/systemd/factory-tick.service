[Unit]
Description=Foreman tick (acts on a new /go or /stop in a work issue)

[Service]
Type=oneshot
Environment=WORK=%h/git/software-factory
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/git/software-factory
ExecStart=/usr/bin/python3 -I %h/git/software-factory/factory/scripts/orchestrate.py tick
TimeoutStartSec=12h
